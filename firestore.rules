// ======================================================
// Craques do Futuro — Regras do Firestore
//
// Quando o projeto for criado/atualizado: Firebase Console > Firestore Database > Rules > colar este conteúdo > Publish.
// Não depende de Firebase CLI/npm.
//
// MODELO DE DADOS
// ------------------------------------------------------
// usuarios/{uid}                        uid = Firebase Auth uid
//   role: "dono" | "administrador" | "tecnico" | "responsavel"
//   escolaId: string | null             a escola "de casa" do administrador/técnico
//                                        (null só pra dono); ver "múltiplas escolas" abaixo
//   atletaIds: array<string>            só para responsavel
//   limiteEscolas: number | ausente     só em administrador de plano com mais de uma escola —
//                                        quantas escolas EXTRAS (além da de casa) ele pode ter
//   licencaFim: Timestamp | ausente     só junto com limiteEscolas — vencimento do PACOTE que
//                                        cobre as escolas extras (ver abaixo)
//
//   Hierarquia de criação: dono cria escolas + administradores (pode ter mais de 1 por escola);
//   administrador cria técnicos (e também pode cadastrar atletas/turmas, mesmo acesso a dados que
//   o técnico); técnico cadastra responsáveis ao registrar um atleta. Administrador e técnico têm
//   o mesmo acesso aos DADOS da escola (atletas/turmas/avaliações/...) — a diferença entre os dois
//   é só que administrador também pode criar técnicos.
//
//   MÚLTIPLAS ESCOLAS (plano mais completo): não existe um papel separado pra isso — é o MESMO
//   "administrador", só que com `limiteEscolas` e `licencaFim` preenchidos no próprio perfil
//   (o dono define isso ao editar o administrador em admin-escolas.html). Com isso, ele pode
//   cadastrar escolas EXTRAS além da "de casa" (a do próprio `escolaId`) em gestor-escolas.html
//   ("Minhas escolas") — até `limiteEscolas`, cada uma virando `escolas/{id}.administradorUid ==
//   seu uid`. Ele "entra" em cada uma (a de casa OU uma extra) pra operar como staff dela.
//   NÃO é o mesmo que "dono": dono tem acesso irrestrito a QUALQUER escola de QUALQUER cliente;
//   este administrador só enxerga/cria/edita/exclui as escolas EXTRAS que ele mesmo criou — a
//   de casa ele edita mas não exclui (isso continua exigindo o dono, ver regra de escolas abaixo).
//   O limite de `limiteEscolas` é checado na regra de criação de escola (abaixo), mas SÓ pra
//   escola nova em si — não tem uma trava de "contar quantas escolas extras ele já tem" na regra
//   (exigiria um contador mantido à parte); por enquanto é reforçado só na interface
//   (gestor-escolas.js esconde o botão de cadastrar depois do limite). Decisão consciente,
//   mesmo padrão de "visibilidade, não bloqueio hermético" já usado pro limite de treinador/aluno.
//   O acesso às escolas extras NÃO depende do licencaFim de CADA escola — só de ele continuar
//   sendo o administradorUid dela (ver isStaffAtivo mais abaixo). Quem corta o acesso de um
//   administrador inadimplente é o DONO, manualmente (desativar/excluir o perfil dele, ou tirar
//   o limiteEscolas/licencaFim se for só as escolas extras que devem sumir).
//
// escolas/{escolaId}
//   nome, licencaInicio, licencaFim (Timestamp), status: "ativa" | "suspensa" | "trial"
//   planoId: string | null — referência a planosAssinatura/{planoId} (null = sem plano definido)
//   administradorUid: string | null — uid de usuarios/{uid} que criou esta escola como EXTRA
//     (via "múltiplas escolas", ver nota acima). null = escola "de casa" de alguém (vínculo vem
//     do lado contrário, usuarios/{uid}.escolaId) ou cadastrada pelo dono direto. Ao criar uma
//     extra, a regra trava `licencaFim` da escola pra nunca passar do `licencaFim` do PACOTE do
//     administrador (meDoc().licencaFim) — não dá pra se dar uma licença de escola mais longa
//     que a do próprio pacote. Quando o dono renova o pacote (estende usuarios/{uid}.licencaFim),
//     isso NÃO atualiza sozinho o licencaFim das escolas extras já criadas — precisa editar cada
//     uma manualmente em admin-escolas.html, igual a qualquer outra escola. Limitação conhecida.
//
//   "trial" = escola criada pelo cadastro público de teste grátis (cadastro-trial.html),
//   sem passar por um dono. licencaFim é travada em no máximo 7 dias a partir da criação
//   DIRETO NA REGRA (ver ehCriacaoDeTrialValida abaixo) — o cliente nunca é confiável pra
//   dizer "meus 7 dias começam quando eu quiser". O acesso expira sozinho pelo mecanismo
//   que já existe (escolaAtiva() checa licencaFim, igual pra qualquer escola paga vencida);
//   não tem Cloud Function apagando nada sozinho. Quem decide apagar uma escola trial
//   vencida e não convertida é o dono, manualmente, na tela "Trials vencidos" do
//   admin-escolas.html.
//
//   escolas/{escolaId}/turmas/{turmaId}          — nome, categoria, temporada, ativa
//   escolas/{escolaId}/atletas/{atletaId}
//     nome, posicao, nascimento, telefone, observacoes, turmaId, status, responsavelUids
//     categoriaAtual, nivelAtual (1-9, ajustado manualmente), nivelDesde (Timestamp — usado para o
//       aviso de "pronto para subir" depois de um tempo mínimo no nível 9)
//     codigoPublico (string, 6 caracteres) — código da "Área do atleta" (ver resumosPublicos abaixo)
//     desativado: boolean — "excluir/desativar atleta" pelo administrador. NÃO é o mesmo campo que
//       `status` (que é a saúde da avaliação, "ativo"/"atencao" — nomes parecidos, coisas
//       diferentes, cuidado). Decisão consciente: não existe exclusão de verdade de atleta a partir
//       do app (perderia o histórico de avaliações/frequência de uma criança por engano) — "excluir"
//       na interface é só esse campo virando true. Só administrador (não técnico) pode mudar esse
//       campo — ver a regra de update abaixo. Ausente/false = ativo.
//     statusPagamento: "em_dia" | "inadimplente" — indicador VISUAL de mensalidade da escolinha
//       em dia, ajustado manualmente pelo técnico/administrador (não tem cobrança de verdade
//       rolando por trás, é só um marcador pra lembrete). Visível pro técnico (card do atleta em
//       atletas.html, com botão pra alternar) e pro responsável (responsavel.html, só leitura).
//       De propósito NÃO aparece em resumosPublicos/área do atleta (link sem login) — é
//       informação sensível de dinheiro, não cabe numa página sem autenticação.
//
//     escolas/{escolaId}/atletas/{atletaId}/progressao/{progressaoId}
//       tipo: "promocao" | "reversao"
//       categoriaAnterior, nivelAnterior, categoriaNova, data
//       -> um checkpoint por promoção/reversão, para nunca perder o histórico entre categorias
//
//   escolas/{escolaId}/avaliacoes/{avaliacaoId}
//     atletaId, data, observacoes
//     notasPorPilar: { fisico: {chave: nota 0-10, ...}, tecnico: {...}, tatico: {...},
//       mental: {...}, potencial: {...} } — nota crua que o avaliador deu por
//       subcategoria (ver PILARES_100 em js/metricas.js, sistema novo desde 2026-09-01).
//     pontuacaoPorPilar: { fisico: {pontos, max}, tecnico: {...}, ... } — já calculado
//       e salvo (pontos ponderados de cada pilar, não recalcula na leitura).
//     notaFinal: soma dos 5 pilares, 0 a ~98,5 (ver nota sobre o pilar Mental
//       em js/metricas.js — ainda não fecha em 100 certinho).
//     tecnico, tatico, fisico, mental, evolucao, geral: ESPELHO de compatibilidade
//       (escala 0-10, "evolucao" = potencial normalizado) pras telas que ainda não
//       migraram pro sistema novo (Dashboard/Relatórios/Comparativos/Responsável/
//       Área do atleta — Fase 3 da migração). Avaliações de ANTES de 2026-09-01
//       só têm esses campos antigos, sem notasPorPilar/pontuacaoPorPilar/notaFinal.
//
//   escolas/{escolaId}/frequencia/{turmaId}_{data}_{atletaId}    id determinístico -> upsert com set()
//     turmaId, atletaId, data, estado: "presente" | "atrasado" | "ausente"
//
//   escolas/{escolaId}/planos/{planoId}
//   escolas/{escolaId}/mensagens/{mensagemId}
//     turmaId, destinatarioId ("turma" | atletaId), destinatarioNome, mensagem, criadoEm
//     -> responsável só lê mensagens onde destinatarioId é um dos atletaIds dele
//
// resumosPublicos/{codigoPublico}                       coleção plana, fora de escolas/{}
//   escolaId, atletaId, nome, radar {tecnico,tatico,fisico,mental,evolucao}, notaGeral,
//   totalPresencas, totalRegistrosFrequencia (a % de presença é calculada no cliente,
//   dividindo esses dois — evita precisar manter um 3º campo sincronizado), atualizadoEm
//   -> resumo público e reduzido de UM atleta, pra "Área do atleta" (area-do-atleta.html):
//      página SEM login, onde o responsável digita o codigoPublico e vê só nome + gráficos.
//      Só tem nome/números aqui, NUNCA telefone, observações, recados ou histórico completo
//      (isso continua exigindo login de verdade em responsavel.html). A leitura é liberada
//      (allow get) só por ID exato — NUNCA por list/query — então não dá pra "varrer" o banco
//      procurando códigos: quem não souber o código de 6 caracteres não acha o documento.
//
// planosAssinatura/{planoId}                            coleção plana, fora de escolas/{}
//   nome, limiteTecnicos (number, 0 = ilimitado), limiteAlunos (number, 0 = ilimitado),
//   ativo (bool — desativar em vez de apagar, pra não quebrar escola já vinculada), criadoEm
//   -> catálogo de planos de ASSINATURA (preço/limite), gerenciado só pelo dono em
//      admin-escolas.html. NÃO confundir com escolas/{escolaId}/planos/{planoId}, que são os
//      planos de TREINO que o técnico cadastra pra turma — nomes parecidos, coisas diferentes.
//      Contagem de uso (quantos treinadores/alunos a escola já tem) é calculada na hora, via
//      getCountFromServer(), não fica guardada/sincronizada em nenhum campo.
//
// solicitacoesPlano/{solicitacaoId}                     coleção plana, fora de escolas/{}
//   escolaId, escolaNome, planoId, planoNome, duracaoMeses (12 | 24),
//   solicitanteNome, solicitanteEmail, status: "pendente" | "confirmada" | "recusada", criadoEm
//   -> pedido criado por um administrador/técnico em escolher-plano.html (funciona mesmo com a
//      licença vencida — é justamente pra isso que serve). O dono revisa em admin-escolas.html
//      ("Solicitações de plano") e confirma manualmente: isso É a "venda" — não tem pagamento
//      processado pelo sistema ainda, o dono confirma depois de receber o pagamento por fora
//      (Pix, link de pagamento etc.). Confirmar grava planoId + recalcula licencaFim na escola.
//
// Papel e vínculos vêm de usuarios/{uid} (lido via get() nas regras), não de custom claims —
// custom claims exigiriam Cloud Functions/Admin SDK, e este projeto é 100% client-side.
// ======================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()      { return request.auth != null; }
    // meuPerfilExiste() existe pra que myRole() nunca precise chamar get().data
    // num documento que ainda não existe — isso é exatamente o que acontece durante
    // o cadastro público de teste grátis, no instante em que a conta de login já foi
    // criada mas o perfil em usuarios/{uid} ainda não. Sem essa guarda, isDono()/
    // isAdmin()/isTecnico() dariam erro de avaliação (em vez de simplesmente "false")
    // pra esse usuário, o que é arriscado demais deixar pra sorte com curto-circuito.
    function meuPerfilExiste() { return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function meDoc()         { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function myRole()        { return (signedIn() && meuPerfilExiste()) ? meDoc().role : null; }
    function myEscolaId()    { return meDoc().escolaId; }
    function myAtletaIds()   { return meDoc().atletaIds; }
    function isDono()        { return myRole() == 'dono'; }
    function isAdmin()       { return myRole() == 'administrador'; }
    function isTecnico()     { return myRole() == 'tecnico'; }

    // Administrador "dono comercial" de uma escola EXTRA (ver nota sobre "múltiplas escolas" no
    // topo do arquivo) — diferente da escola "de casa" (vínculo fixo em usuarios/{uid}.escolaId),
    // o vínculo com uma escola extra vive no campo administradorUid da PRÓPRIA escola.
    function souAdminDaEscolaExtra(escolaId) {
      return signedIn() && isAdmin()
        && get(/databases/$(database)/documents/escolas/$(escolaId)).data.administradorUid == request.auth.uid;
    }

    // Cadastro público de teste grátis (cadastro-trial.html) — ver nota sobre
    // "trial" no modelo de dados, no topo do arquivo.
    function ehCriacaoDeTrialValida(dados) {
      return dados.status == 'trial'
        && dados.licencaFim > request.time
        && dados.licencaFim <= dados.licencaInicio + duration.value(7, 'd')
        && dados.licencaInicio <= request.time;
    }

    function escolaAtiva(id) {
      return get(/databases/$(database)/documents/escolas/$(id)).data.licencaFim >= request.time;
    }

    // administrador e técnico têm o mesmo acesso aos dados da escola "de casa", contanto que a
    // licença esteja válida. Administrador ganha o MESMO acesso dentro de qualquer escola EXTRA
    // que ele mesmo gerencia (souAdminDaEscolaExtra) SEM depender do licencaFim dela — a escola
    // em si é dele (pode até excluí-la), então o controle é só "essa escola é sua?", não licença
    // por licença; quem decide cortar um administrador inadimplente é o dono, manualmente.
    function isStaffAtivo(escolaId) {
      return signedIn()
        && (((isAdmin() || isTecnico()) && myEscolaId() == escolaId && escolaAtiva(escolaId))
            || souAdminDaEscolaExtra(escolaId));
    }

    // Só administrador (da própria escola de casa, com licença válida, ou dono de uma escola
    // extra, ver isStaffAtivo acima) pode criar conta de técnico — técnico sozinho não cria
    // outro técnico.
    function podeCriarTecnico(escolaId) {
      return (isAdmin() && myEscolaId() == escolaId && escolaAtiva(escolaId)) || souAdminDaEscolaExtra(escolaId);
    }

    function isResponsavelDe(escolaId, atletaId) {
      return signedIn() && myRole() == 'responsavel' && myEscolaId() == escolaId
             && atletaId in myAtletaIds();
    }

    match /usuarios/{uid} {
      // Além do próprio perfil e do dono, um administrador/técnico/responsável também pode ser
      // LIDO por quem mais atende a mesma escola (isStaffAtivo) — usado pra contar treinadores
      // (getCountFromServer) e listar técnicos/administradores em admin-escolas.html/
      // gestor-escolas.html/configuracoes.html.
      allow read: if signedIn()
        && (request.auth.uid == uid || isDono()
            || (resource.data.escolaId != null && isStaffAtivo(resource.data.escolaId)));

      // dono cria/edita qualquer perfil; administrador só CRIA técnicos da própria escola (de
      // casa ou extra); administrador/técnico só CRIAM perfis de responsável da própria escola;
      // e um usuário totalmente novo (sem perfil ainda) pode criar o PRÓPRIO perfil de
      // administrador, mas só apontando pra uma escola que ele acabou de criar como trial
      // (a escola já precisa existir com status 'trial' — ver ordem em cadastro-trial.js:
      // primeiro cria a escola, depois este perfil).
      allow create: if isDono()
        || (podeCriarTecnico(request.resource.data.escolaId)
            && request.resource.data.role == 'tecnico')
        || (isStaffAtivo(request.resource.data.escolaId)
            && request.resource.data.role == 'responsavel')
        || (souAdminDaEscolaExtra(request.resource.data.escolaId)
            && request.resource.data.role == 'administrador')
        || (signedIn() && request.auth.uid == uid && !meuPerfilExiste()
            && request.resource.data.role == 'administrador'
            && get(/databases/$(database)/documents/escolas/$(request.resource.data.escolaId)).data.status == 'trial');

      // administrador/técnico podem só adicionar atletaIds a um perfil de responsável
      // da escola que atendem (isStaffAtivo já cobre os dois, ver função acima)
      allow update: if isDono()
        || (isStaffAtivo(resource.data.escolaId)
            && resource.data.role == 'responsavel'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['atletaIds']));

      // dono apaga qualquer perfil; administrador só apaga perfis (administrador/técnico/
      // responsável, sempre têm escolaId) de uma escola EXTRA que ELE MESMO gerencia — usado ao
      // excluir essa escola inteira em gestor-escolas.js (mesmo padrão de
      // excluirEscolaTrialVencida do dono). Não cobre a escola de casa dele mesmo — apagar
      // colegas da própria escola continua exigindo o dono.
      allow delete: if isDono()
        || (isAdmin() && resource.data.escolaId != null && souAdminDaEscolaExtra(resource.data.escolaId));
    }

    match /escolas/{escolaId} {
      // isStaffAtivo já cobre "administrador dono desta escola extra" incondicionalmente (não
      // depende de escolaAtiva, ver função acima) — então ele sempre lê as próprias escolas
      // extras, mesmo com licença vencida, sem precisar de uma cláusula à parte aqui.
      allow read:  if isDono() || isStaffAtivo(escolaId)
                   || (myRole() == 'responsavel' && myEscolaId() == escolaId);
      // create: dono cria qualquer escola; OU um usuário autenticado sem nenhum perfil
      // ainda pode criar UMA escola de teste grátis pra si mesmo (o próximo passo dele é
      // criar o próprio usuarios/{uid} apontando pra cá — ver regra de usuarios acima); OU
      // um administrador com limiteEscolas/licencaFim no próprio perfil cria uma escola EXTRA
      // sua (administradorUid == seu uid), com a licença dela travada pra nunca passar do
      // vencimento do PACOTE dele (meDoc().licencaFim) — ver nota sobre "múltiplas escolas"
      // no topo do arquivo.
      allow create: if isDono()
        || (signedIn() && !meuPerfilExiste() && ehCriacaoDeTrialValida(request.resource.data))
        || (isAdmin() && request.resource.data.administradorUid == request.auth.uid
            && request.resource.data.status == 'ativa'
            && 'limiteEscolas' in meDoc() && meDoc().limiteEscolas > 0
            && 'licencaFim' in meDoc()
            && request.resource.data.licencaFim <= meDoc().licencaFim);
      // update: dono edita qualquer campo; administrador (na de casa OU numa extra que
      // gerencia) só pode renomear (nunca mexer em licencaFim/status/planoId/administradorUid
      // por essa via — quem controla isso é o dono). delete: dono apaga qualquer escola
      // (inclusive trial vencida); administrador apaga só as EXTRAS que ele mesmo criou —
      // NÃO pode excluir a própria escola de casa (só o dono), decisão consciente pra não
      // deixar a escola "sumir" sem o dono saber.
      allow update: if isDono()
        || ((souAdminDaEscolaExtra(escolaId)
             || (isAdmin() && myEscolaId() == escolaId && escolaAtiva(escolaId)))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome']));
      allow delete: if isDono() || souAdminDaEscolaExtra(escolaId);

      match /turmas/{turmaId} {
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || (myRole() == 'responsavel' && myEscolaId() == escolaId);
        allow write: if isDono() || isStaffAtivo(escolaId);
      }

      match /atletas/{atletaId} {
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || isResponsavelDe(escolaId, atletaId);
        allow create: if isDono() || isStaffAtivo(escolaId);
        // "desativado" (excluir/desativar, ver nota no modelo de dados) só pode ser mudado por
        // administrador/dono — técnico continua podendo editar/cadastrar atleta normalmente,
        // só não pode desativar ninguém.
        allow update: if isDono()
          || (isStaffAtivo(escolaId)
              && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['desativado'])));
        allow delete: if isDono();

        match /progressao/{progressaoId} {
          allow read:  if isDono() || isStaffAtivo(escolaId)
                       || isResponsavelDe(escolaId, atletaId);
          allow write: if isDono() || isStaffAtivo(escolaId);
        }
      }

      match /avaliacoes/{avaliacaoId} {
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || isResponsavelDe(escolaId, resource.data.atletaId);
        allow write: if isDono() || isStaffAtivo(escolaId);
      }

      match /frequencia/{frequenciaId} {
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || isResponsavelDe(escolaId, resource.data.atletaId);
        allow write: if isDono() || isStaffAtivo(escolaId);
      }

      match /planos/{planoId} {
        allow read, write: if isDono() || isStaffAtivo(escolaId);   // responsável não vê planos na v1
      }

      match /mensagens/{mensagemId} {
        // responsável só vê recados endereçados diretamente ao atleta dele —
        // recados "para toda a turma" (destinatarioId == "turma") continuam só
        // pra equipe, porque confirmar que o atleta pertence àquela turma
        // exigiria mais uma leitura por regra; pode ampliar depois se precisar.
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || isResponsavelDe(escolaId, resource.data.destinatarioId);
        allow write: if isDono() || isStaffAtivo(escolaId);
      }
    }

    // "Área do atleta" (area-do-atleta.html) — ver nota sobre resumosPublicos no topo do arquivo.
    // allow get (não list) com "if true" é intencional: só quem já tem o código de 6 caracteres
    // consegue buscar o documento exato; ninguém consegue listar/varrer a coleção sem o código.
    match /resumosPublicos/{codigoPublico} {
      allow get: if true;
      allow list: if false;
      allow create: if isDono() || isStaffAtivo(request.resource.data.escolaId);
      allow update, delete: if isDono() || isStaffAtivo(resource.data.escolaId);
    }

    // Catálogo de planos de assinatura — só o dono mexe aqui (ver nota no topo do arquivo).
    match /planosAssinatura/{planoId} {
      allow read, write: if isDono();
    }

    // Pedidos de plano — administrador/técnico da escola cria (mesmo com licença vencida,
    // de propósito: não usa isStaffAtivo() porque isso exigiria escolaAtiva()); só o dono
    // confirma/recusa. Sem update por quem criou — depois de enviado, não dá pra editar.
    match /solicitacoesPlano/{solicitacaoId} {
      allow read: if isDono()
        || (signedIn() && (isAdmin() || isTecnico()) && myEscolaId() == resource.data.escolaId);
      allow create: if signedIn() && (isAdmin() || isTecnico())
        && request.resource.data.escolaId == myEscolaId()
        && request.resource.data.status == 'pendente';
      allow update, delete: if isDono();
    }
  }
}
