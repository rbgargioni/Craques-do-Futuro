// ======================================================
// Craques do Futuro — Regras do Firestore
//
// Quando o projeto for criado/atualizado: Firebase Console > Firestore Database > Rules > colar este conteúdo > Publish.
// Não depende de Firebase CLI/npm.
//
// MODELO DE DADOS
// ------------------------------------------------------
// usuarios/{uid}                        uid = Firebase Auth uid
//   role: "dono" | "administrador" | "tecnico" | "responsavel"
//   escolaId: string | null             null só para dono
//   atletaIds: array<string>            só para responsavel
//
//   Hierarquia de criação: dono cria escolas + administradores (pode ter mais de 1 por escola);
//   administrador cria técnicos (e também pode cadastrar atletas/turmas, mesmo acesso a dados que
//   o técnico); técnico cadastra responsáveis ao registrar um atleta. Administrador e técnico têm
//   o mesmo acesso aos DADOS da escola (atletas/turmas/avaliações/...) — a diferença entre os dois
//   é só que administrador também pode criar técnicos.
//
// escolas/{escolaId}
//   nome, licencaInicio, licencaFim (Timestamp), status: "ativa" | "suspensa"
//
//   escolas/{escolaId}/turmas/{turmaId}          — nome, categoria, temporada, ativa
//   escolas/{escolaId}/atletas/{atletaId}
//     nome, posicao, nascimento, telefone, observacoes, turmaId, status, responsavelUids
//     categoriaAtual, nivelAtual (1-9, ajustado manualmente), nivelDesde (Timestamp — usado para o
//       aviso de "pronto para subir" depois de um tempo mínimo no nível 9)
//     codigoPublico (string, 6 caracteres) — código da "Área do atleta" (ver resumosPublicos abaixo)
//
//     escolas/{escolaId}/atletas/{atletaId}/progressao/{progressaoId}
//       tipo: "promocao" | "reversao"
//       categoriaAnterior, nivelAnterior, categoriaNova, data
//       -> um checkpoint por promoção/reversão, para nunca perder o histórico entre categorias
//
//   escolas/{escolaId}/avaliacoes/{avaliacaoId}
//     atletaId, data, tecnico, tatico, fisico, mental, evolucao, geral, observacoes
//
//   escolas/{escolaId}/frequencia/{turmaId}_{data}_{atletaId}    id determinístico -> upsert com set()
//     turmaId, atletaId, data, estado: "presente" | "atrasado" | "ausente"
//
//   escolas/{escolaId}/planos/{planoId}
//   escolas/{escolaId}/mensagens/{mensagemId}
//     turmaId, destinatarioId ("turma" | atletaId), destinatarioNome, mensagem, criadoEm
//     -> responsável só lê mensagens onde destinatarioId é um dos atletaIds dele
//
// resumosPublicos/{codigoPublico}                       coleção plana, fora de escolas/{}
//   escolaId, atletaId, nome, radar {tecnico,tatico,fisico,mental,evolucao}, notaGeral,
//   totalPresencas, totalRegistrosFrequencia (a % de presença é calculada no cliente,
//   dividindo esses dois — evita precisar manter um 3º campo sincronizado), atualizadoEm
//   -> resumo público e reduzido de UM atleta, pra "Área do atleta" (area-do-atleta.html):
//      página SEM login, onde o responsável digita o codigoPublico e vê só nome + gráficos.
//      Só tem nome/números aqui, NUNCA telefone, observações, recados ou histórico completo
//      (isso continua exigindo login de verdade em responsavel.html). A leitura é liberada
//      (allow get) só por ID exato — NUNCA por list/query — então não dá pra "varrer" o banco
//      procurando códigos: quem não souber o código de 6 caracteres não acha o documento.
//
// Papel e vínculos vêm de usuarios/{uid} (lido via get() nas regras), não de custom claims —
// custom claims exigiriam Cloud Functions/Admin SDK, e este projeto é 100% client-side.
// ======================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()      { return request.auth != null; }
    function meDoc()         { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function myRole()        { return signedIn() ? meDoc().role : null; }
    function myEscolaId()    { return meDoc().escolaId; }
    function myAtletaIds()   { return meDoc().atletaIds; }
    function isDono()        { return myRole() == 'dono'; }
    function isAdmin()       { return myRole() == 'administrador'; }
    function isTecnico()     { return myRole() == 'tecnico'; }

    function escolaAtiva(id) {
      return get(/databases/$(database)/documents/escolas/$(id)).data.licencaFim >= request.time;
    }

    // administrador e técnico têm o mesmo acesso aos dados da escola, contanto que a licença esteja válida
    function isStaffAtivo(escolaId) {
      return signedIn() && (isAdmin() || isTecnico()) && myEscolaId() == escolaId && escolaAtiva(escolaId);
    }

    function isResponsavelDe(escolaId, atletaId) {
      return signedIn() && myRole() == 'responsavel' && myEscolaId() == escolaId
             && atletaId in myAtletaIds();
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDono());

      // dono cria/edita qualquer perfil; administrador só CRIA técnicos da própria escola;
      // administrador/técnico só CRIAM perfis de responsável da própria escola
      allow create: if isDono()
        || (isAdmin() && escolaAtiva(myEscolaId())
            && request.resource.data.role == 'tecnico'
            && request.resource.data.escolaId == myEscolaId())
        || (isStaffAtivo(request.resource.data.escolaId)
            && request.resource.data.role == 'responsavel');

      // administrador/técnico podem só adicionar atletaIds a um perfil de responsável da própria escola
      allow update: if isDono()
        || (isStaffAtivo(myEscolaId())
            && resource.data.role == 'responsavel'
            && resource.data.escolaId == myEscolaId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['atletaIds']));

      allow delete: if isDono();
    }

    match /escolas/{escolaId} {
      allow read:  if isDono() || isStaffAtivo(escolaId)
                   || (myRole() == 'responsavel' && myEscolaId() == escolaId);
      allow write: if isDono();

      match /turmas/{turmaId} {
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || (myRole() == 'responsavel' && myEscolaId() == escolaId);
        allow write: if isDono() || isStaffAtivo(escolaId);
      }

      match /atletas/{atletaId} {
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || isResponsavelDe(escolaId, atletaId);
        allow write: if isDono() || isStaffAtivo(escolaId);

        match /progressao/{progressaoId} {
          allow read:  if isDono() || isStaffAtivo(escolaId)
                       || isResponsavelDe(escolaId, atletaId);
          allow write: if isDono() || isStaffAtivo(escolaId);
        }
      }

      match /avaliacoes/{avaliacaoId} {
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || isResponsavelDe(escolaId, resource.data.atletaId);
        allow write: if isDono() || isStaffAtivo(escolaId);
      }

      match /frequencia/{frequenciaId} {
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || isResponsavelDe(escolaId, resource.data.atletaId);
        allow write: if isDono() || isStaffAtivo(escolaId);
      }

      match /planos/{planoId} {
        allow read, write: if isDono() || isStaffAtivo(escolaId);   // responsável não vê planos na v1
      }

      match /mensagens/{mensagemId} {
        // responsável só vê recados endereçados diretamente ao atleta dele —
        // recados "para toda a turma" (destinatarioId == "turma") continuam só
        // pra equipe, porque confirmar que o atleta pertence àquela turma
        // exigiria mais uma leitura por regra; pode ampliar depois se precisar.
        allow read:  if isDono() || isStaffAtivo(escolaId)
                     || isResponsavelDe(escolaId, resource.data.destinatarioId);
        allow write: if isDono() || isStaffAtivo(escolaId);
      }
    }

    // "Área do atleta" (area-do-atleta.html) — ver nota sobre resumosPublicos no topo do arquivo.
    // allow get (não list) com "if true" é intencional: só quem já tem o código de 6 caracteres
    // consegue buscar o documento exato; ninguém consegue listar/varrer a coleção sem o código.
    match /resumosPublicos/{codigoPublico} {
      allow get: if true;
      allow list: if false;
      allow create: if isDono() || isStaffAtivo(request.resource.data.escolaId);
      allow update, delete: if isDono() || isStaffAtivo(resource.data.escolaId);
    }
  }
}
